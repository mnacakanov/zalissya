; Zalissya — Godot technical demo (see README.md). Not the game.
config_version=5

[application]
config/name="Залісся демо"
config/icon="res://icons/icon_512.png"
run/main_scene="res://maidan.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1000
window/size/viewport_height=760
window/stretch/mode="disabled"
window/stretch/aspect="expand"

[importer_defaults]
texture={
"compress/mode": 1,
"compress/lossy_quality": 0.85,
"mipmaps/generate": false
}

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=1
environment/defaults/default_clear_color=Color(0.2, 0.3, 0.15, 1)
